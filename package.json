{
  "name": "gur",
  "private": true,
  "description": "Gur: a closed-hand tile rummy game for web, Android and iOS",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:e2e": "turbo run test:e2e",
    "dev": "turbo run build --filter=@gur/engine && pnpm --filter @gur/client start"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1"
  }
}
