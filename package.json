{
  "name": "gur",
  "private": true,
  "description": "Gur: a closed-hand tile rummy game for web, Android and iOS",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:e2e": "turbo run test:e2e",
    "dev": "turbo run build --filter=@gur/engine && pnpm --filter @gur/client start"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "turbo": "2.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.2"
  }
}
