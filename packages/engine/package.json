{
  "name": "@gur/engine",
  "version": "0.1.0",
  "private": true,
  "description": "The rules of Gur: tiles, melds, closing hands, turns and scoring",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "vitest": "5.1.0"
  }
}
